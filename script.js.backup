// DOM Elements
const navbar = document.getElementById('navbar');
const heroSection = document.getElementById('hero');
const navHome = document.getElementById('nav-home');
const navSeries = document.getElementById('nav-series');
const navMovies = document.getElementById('nav-movies');
const navNew = document.getElementById('nav-new');
const navList = document.getElementById('nav-list');
const navItems = [navHome, navSeries, navMovies, navNew, navList];

const detailModal = document.getElementById('detail-modal');
const modalTitle = document.getElementById('modal-title');
const modalDesc = document.getElementById('modal-description');
const modalBackdrop = document.getElementById('modal-backdrop-img');
const modalRating = document.getElementById('modal-rating');
const modalYear = document.getElementById('modal-year');
const modalDuration = document.getElementById('modal-duration');
const modalPlayBtn = document.getElementById('modal-play-btn');
const closeDetailModal = document.getElementById('close-detail-modal');
const relatedGrid = document.getElementById('related-grid');

const videoOverlay = document.getElementById('video-overlay');
const videoContainer = document.getElementById('video-container');
const closeVideoBtn = document.getElementById('close-video');

const searchTrigger = document.getElementById('search-trigger');
const searchOverlay = document.getElementById('search-overlay');
const searchInputFull = document.getElementById('search-input-full');
const closeSearch = document.getElementById('close-search');
const searchGridFull = document.getElementById('search-grid-full');

// Initialization
document.addEventListener('DOMContentLoaded', () => {
    initializeApp();
    setupNavigation();
    setupSliderScroll();
    setupSearch();
    startHeroCarousel();

    // Dismiss loading screen
    const loadingScreen = document.getElementById('loading-screen');
    if (loadingScreen) {
        setTimeout(() => {
            loadingScreen.classList.add('hidden');
            setTimeout(() => loadingScreen.remove(), 600);
        }, 800);
    }

    // Navbar scroll effect
    window.addEventListener('scroll', () => {
        if (window.scrollY > 50) {
            navbar.classList.add('scrolled');
        } else {
            navbar.classList.remove('scrolled');
        }
    });
});

function initializeApp(filterValues = null) {
    if (filterValues) {
        if (filterValues.type) {
            currentMovies = movies.filter(m => m.type === filterValues.type);
        } else if (filterValues.category) {
            currentMovies = movies.filter(m => m.categories.includes(filterValues.category));
        } else {
            currentMovies = [...movies];
        }
    } else {
        currentMovies = [...movies];
    }

    renderHero(currentMovies[0]);

    const trending = movies.filter(m => m.categories.includes('Trending')).slice(0, 15);
    renderRow(trending, 'trending-slider');

    const newReleases = movies.filter(m => m.categories.includes('New')).slice(0, 15);
    renderRow(newReleases, 'new-slider');

    const scifi = movies.filter(m => m.categories.includes('Sci-Fi') || m.categories.includes('Fantasy')).slice(0, 15);
    renderRow(scifi, 'scifi-slider');

    // Bottom Categorical Rows
    const moviesOnly = movies.filter(m => m.type === 'Movie').slice(0, 15);
    renderRow(moviesOnly, 'movies-row-slider');

    const seriesOnly = movies.filter(m => m.type === 'Series').slice(0, 15);
    renderRow(seriesOnly, 'series-row-slider');

    const animeOnly = movies.filter(m => m.categories.includes('Animation')).slice(0, 15);
    renderRow(animeOnly, 'anime-row-slider');

    const kidsOnly = movies.filter(m => m.categories.includes('Family')).slice(0, 15);
    renderRow(kidsOnly, 'kids-row-slider');
}

// Hero Carousel
let heroInterval;
let heroIndex = 0;

function startHeroCarousel() {
    if (heroInterval) clearInterval(heroInterval);
    const heroMovies = movies.filter(m => m.categories.includes('Trending')).slice(0, 6);

    heroInterval = setInterval(() => {
        heroIndex = (heroIndex + 1) % heroMovies.length;
        renderHero(heroMovies[heroIndex]);
    }, 5000);
}

// Search
function setupSearch() {
    if (!searchTrigger) return;

    searchTrigger.addEventListener('click', () => {
        searchOverlay.classList.add('active');
        searchInputFull.focus();
        document.body.style.overflow = 'hidden';
    });

    closeSearch.addEventListener('click', () => {
        searchOverlay.classList.remove('active');
        document.body.style.overflow = '';
        searchInputFull.value = '';
        searchGridFull.innerHTML = '';
    });

    searchInputFull.addEventListener('input', (e) => {
        const query = e.target.value.toLowerCase();

        if (query.length > 0) {
            const results = movies.filter(m =>
                m.title.toLowerCase().includes(query) ||
                m.categories.some(c => c.toLowerCase().includes(query))
            );
            renderSearchResults(results);
        } else {
            searchGridFull.innerHTML = '';
        }
    });
}

function renderSearchResults(results) {
    searchGridFull.innerHTML = '';
    if (results.length === 0) {
        searchGridFull.innerHTML = '<p style="color:#666; font-size: 1.5rem; text-align:center; width:100%;">No results found</p>';
        return;
    }

    results.forEach(movie => {
        const card = document.createElement('div');
        card.className = 'grid-card';
        card.onclick = () => {
            searchOverlay.classList.remove('active');
            document.body.style.overflow = '';
            openModal(movie);
        };
        card.innerHTML = `<img src="${movie.poster}" loading="lazy" onerror="this.src='https://placehold.co/500x750/111/eee?text=${encodeURIComponent(movie.title)}'">`;
        searchGridFull.appendChild(card);
    });
}

// Render Hero
function renderHero(movie) {
    if (!movie) return;

    heroSection.style.backgroundImage = `url('${movie.backdrop}')`;
    heroSection.innerHTML = `
                <div class="hero-content">
                    <h1 class="hero-title">${movie.title}</h1>
                    <p class="hero-desc">${movie.description}</p>
                    <div class="hero-buttons">
                        <button class="btn btn-primary" onclick="playMovie(${movie.tmdbId}, ${movie.type === 'Series'})">
                            <i class="fa-solid fa-play"></i> Watch Now
                        </button>
                        <button class="btn btn-secondary" onclick="openModalById(${movie.id})">
                            <i class="fa-solid fa-circle-info"></i> More Info
                        </button>
                    </div>
                </div>
            `;
}

// Render Row
function renderRow(movieList, elementId) {
    const slider = document.getElementById(elementId);
    if (!slider) return;
    slider.innerHTML = '';

    if (movieList.length === 0) {
        slider.innerHTML = '<p style="padding:1rem;color:#888;">No content</p>';
        return;
    }

    movieList.forEach(movie => {
        const card = document.createElement('div');
        card.className = 'movie-card';
        card.onclick = () => openModal(movie);
        card.innerHTML = `<img src="${movie.poster}" alt="${movie.title}" loading="lazy" onerror="this.src='https://placehold.co/500x750/111/eee?text=${encodeURIComponent(movie.title)}'">`;
        slider.appendChild(card);
    });
}

// Navigation
function setupNavigation() {
    navItems.forEach(item => {
        if (!item) return;
        item.addEventListener('click', () => {
            navItems.forEach(n => n && n.classList.remove('active'));
            item.classList.add('active');

            if (item.id === 'nav-home') initializeApp();
            if (item.id === 'nav-series') initializeApp({ type: 'Series' });
            if (item.id === 'nav-movies') initializeApp({ type: 'Movie' });
            if (item.id === 'nav-new') initializeApp({ category: 'New' });
            if (item.id === 'nav-list') alert('My List feature coming soon!');
        });
    });
}

// Slider Scrolling
function setupSliderScroll() {
    document.querySelectorAll('.slider-container').forEach(container => {
        const slider = container.querySelector('.slider');
        const leftBtn = container.querySelector('.left-handle');
        const rightBtn = container.querySelector('.right-handle');

        if (leftBtn) {
            leftBtn.addEventListener('click', () => {
                slider.scrollBy({ left: -600, behavior: 'smooth' });
            });
        }

        if (rightBtn) {
            rightBtn.addEventListener('click', () => {
                slider.scrollBy({ left: 600, behavior: 'smooth' });
            });
        }
    });
}

// Open Modal by ID
window.openModalById = function (movieId) {
    const movie = movies.find(m => m.id === movieId);
    if (movie) openModal(movie);
};

// Open Modal
function openModal(movie) {
    modalTitle.textContent = movie.title;
    modalDesc.textContent = movie.description;
    modalBackdrop.src = movie.backdrop;
    modalRating.textContent = movie.rating;
    modalYear.textContent = movie.year;
    modalDuration.textContent = movie.duration;

    modalPlayBtn.onclick = () => {
        closeDetailModalFunc();
        playMovie(movie.tmdbId, movie.type === 'Series');
    };

    const oldSection = document.getElementById('seasons-parts-section');
    if (oldSection) oldSection.remove();

    // Add Seasons (for Series)
    if (movie.type === 'Series' && movie.seasons) {
        const seasonsHTML = `
                    <div id="seasons-parts-section" class="seasons-section">
                        <h3>📺 Seasons</h3>
                        <div class="seasons-grid">
                            ${movie.seasons.map(s => `
                                <div class="season-card" onclick="playEpisode(${movie.tmdbId}, ${s.number}, 1)">
                                    <div class="season-number">S${s.number}</div>
                                    <div class="season-info">
                                        <span class="season-title">${s.title}</span>
                                        <span class="season-episodes">${s.episodes} Episodes • ${s.year}</span>
                                    </div>
                                </div>
                            `).join('')}
                        </div>
                    </div>
                `;
        relatedGrid.parentElement.insertAdjacentHTML('beforebegin', seasonsHTML);
    }

    // Add Parts (for Movies with sequels)
    if (movie.type === 'Movie' && movie.parts) {
        const partsHTML = `
                    <div id="seasons-parts-section" class="parts-section">
                        <h3>🎬 Movie Collection</h3>
                        <div class="parts-grid">
                            ${movie.parts.map(p => `
                                <div class="part-card ${p.current ? 'current' : ''}" onclick="playMovie(${p.tmdbId}, false)">
                                    <img src="${p.poster}" alt="${p.title}">
                                    <div class="part-info">
                                        <span class="part-title">${p.title}</span>
                                        <span class="part-year">${p.year}</span>
                                    </div>
                                    ${p.current ? '<span class="current-badge">Current</span>' : ''}
                                </div>
                            `).join('')}
                        </div>
                    </div>
                `;
        relatedGrid.parentElement.insertAdjacentHTML('beforebegin', partsHTML);
    }

    // Related: Same category
    const related = movies.filter(m => m.id !== movie.id && m.categories.some(c => movie.categories.includes(c))).slice(0, 6);
    renderRelated(related);

    detailModal.classList.add('active');
    document.body.style.overflow = 'hidden';
}

function renderRelated(list) {
    relatedGrid.innerHTML = '';
    list.forEach(m => {
        const div = document.createElement('div');
        div.className = 'grid-card';
        div.onclick = () => {
            openModal(m);
            detailModal.scrollTop = 0;
        };
        div.innerHTML = `<img src="${m.poster}" loading="lazy">`;
        relatedGrid.appendChild(div);
    });
}

function closeDetailModalFunc() {
    detailModal.classList.remove('active');
    if (!searchOverlay.classList.contains('active')) {
        document.body.style.overflow = '';
    }
    const section = document.getElementById('seasons-parts-section');
    if (section) section.remove();
}

closeDetailModal.addEventListener('click', closeDetailModalFunc);
detailModal.addEventListener('click', (e) => {
    if (e.target === detailModal) closeDetailModalFunc();
});

// FULL MOVIE Player using vidsrc
window.playMovie = function (tmdbId, isSeries = false) {
    let embedUrl;
    if (isSeries) {
        embedUrl = `https://player.autoembed.cc/embed/tv/${tmdbId}/1/1`;
    } else {
        embedUrl = `https://player.autoembed.cc/embed/movie/${tmdbId}`;
    }

    videoContainer.innerHTML = `
        <iframe 
            src="${embedUrl}" 
            allowfullscreen
            webkitallowfullscreen
            mozallowfullscreen
            allow="autoplay; fullscreen; picture-in-picture; encrypted-media; gyroscope; accelerometer"
            style="width:100%;height:100%;border:none;">
        </iframe>
    `;
    videoOverlay.classList.add('active');
    document.body.style.overflow = 'hidden';
};

// Play specific episode
window.playEpisode = function (tmdbId, season, episode) {
    const embedUrl = `https://player.autoembed.cc/embed/tv/${tmdbId}/${season}/${episode}`;

    videoContainer.innerHTML = `
        <iframe 
            src="${embedUrl}" 
            allowfullscreen
            webkitallowfullscreen
            mozallowfullscreen
            allow="autoplay; fullscreen; picture-in-picture; encrypted-media; gyroscope; accelerometer"
            style="width:100%;height:100%;border:none;">
        </iframe>
    `;
    videoOverlay.classList.add('active');
    document.body.style.overflow = 'hidden';
};

closeVideoBtn.addEventListener('click', () => {
    videoOverlay.classList.remove('active');
    videoContainer.innerHTML = '';
    document.body.style.overflow = '';
});

// Fullscreen Toggle Logic
const fullscreenVideoBtn = document.getElementById('fullscreen-video');
if (fullscreenVideoBtn) {
    fullscreenVideoBtn.addEventListener('click', () => {
        if (!document.fullscreenElement && !document.webkitFullscreenElement && !document.mozFullScreenElement && !document.msFullscreenElement) {
            // ENTER FULLSCREEN & ROTATE
            let reqPromise;
            if (videoContainer.requestFullscreen) {
                reqPromise = videoContainer.requestFullscreen();
            } else if (videoContainer.webkitRequestFullscreen) {
                reqPromise = videoContainer.webkitRequestFullscreen();
            } else if (videoContainer.msRequestFullscreen) {
                reqPromise = videoContainer.msRequestFullscreen();
            } else if (videoContainer.children[0] && videoContainer.children[0].tagName === 'IFRAME') {
                if (videoContainer.children[0].webkitEnterFullscreen) {
                    videoContainer.children[0].webkitEnterFullscreen();
                }
            }

            // Attempt to lock orientation to lanscape
            if (reqPromise instanceof Promise) {
                reqPromise.then(() => {
                    if (screen.orientation && screen.orientation.lock) {
                        screen.orientation.lock('landscape').catch(() => { });
                    }
                }).catch(() => { });
            } else {
                if (screen.orientation && screen.orientation.lock) {
                    try { screen.orientation.lock('landscape').catch(() => { }); } catch (e) { }
                }
            }

        } else {
            // EXIT FULLSCREEN & UNLOCK
            if (document.exitFullscreen) {
                document.exitFullscreen();
            } else if (document.webkitExitFullscreen) {
                document.webkitExitFullscreen();
            } else if (document.mozCancelFullScreen) {
                document.mozCancelFullScreen();
            } else if (document.msExitFullscreen) {
                document.msExitFullscreen();
            }

            if (screen.orientation && screen.orientation.unlock) {
                try { screen.orientation.unlock(); } catch (e) { }
            }
        }
    });
}

// ==========================================
// PROFESSIONAL SERVER SWITCHING SYSTEM
// ==========================================

let currentServer = 'auto'; // Default server
let activeTmdbId = null;
let activeIsSeries = false;
let activeSeason = 1;
let activeEpisode = 1;

// Handle Server Selection
document.querySelectorAll('.server-btn').forEach(btn => {
    btn.addEventListener('click', (e) => {
        // Visual Update
        document.querySelectorAll('.server-btn').forEach(b => b.classList.remove('active'));
        e.target.classList.add('active');

        // State Update
        currentServer = e.target.getAttribute('data-server');

        // Reload Video
        if (activeTmdbId) {
            loadVideoContent();
        }
    });
});

function loadVideoContent() {
    let baseUrl;
    let isAutoEmbed = false;
    
    switch (currentServer) {
        case 'auto': 
            baseUrl = 'https://player.autoembed.cc/embed'; 
            isAutoEmbed = true;
            break;
        case 'vme': 
            baseUrl = 'https://vidsrc.me/embed'; 
            break;
        case 'binge': 
            baseUrl = 'https://vidbinge.dev/embed'; 
            break;
        default: 
            baseUrl = 'https://player.autoembed.cc/embed';
            isAutoEmbed = true;
    }

    let embedUrl;
    if (activeIsSeries) {
        if (isAutoEmbed) {
            embedUrl = `${baseUrl}/tv/${activeTmdbId}/${activeSeason}/${activeEpisode}`;
        } else {
            embedUrl = `${baseUrl}/tv?tmdb=${activeTmdbId}&season=${activeSeason}&episode=${activeEpisode}`;
            // standard vidsrc format fallback
            if (currentServer === 'vme') {
                 embedUrl = `${baseUrl}/tv/${activeTmdbId}/${activeSeason}/${activeEpisode}`;
            }
        }
    } else {
        if (isAutoEmbed || currentServer === 'vme') {
            embedUrl = `${baseUrl}/movie/${activeTmdbId}`;
        } else {
            embedUrl = `${baseUrl}/movie?tmdb=${activeTmdbId}`;
        }
    }

    videoContainer.innerHTML = `
        <iframe 
            src="${embedUrl}" 
            allowfullscreen
            webkitallowfullscreen
            mozallowfullscreen
            allow="autoplay; fullscreen; picture-in-picture; encrypted-media; gyroscope; accelerometer"
            style="width:100%;height:100%;border:none;">
        </iframe>
    `;
}

// Override Play Functions to use new System
window.playMovie = function (tmdbId, isSeries = false) {
    activeTmdbId = tmdbId;
    activeIsSeries = isSeries;
    activeSeason = 1;
    activeEpisode = 1;

    loadVideoContent();

    videoOverlay.classList.add('active');
    document.body.style.overflow = 'hidden';
};

window.playEpisode = function (tmdbId, season, episode) {
    activeTmdbId = tmdbId;
    activeIsSeries = true;
    activeSeason = season;
    activeEpisode = episode;

    loadVideoContent();

    videoOverlay.classList.add('active');
    document.body.style.overflow = 'hidden';
};
