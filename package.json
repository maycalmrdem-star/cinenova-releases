{
  "name": "cinenova",
  "version": "5.0.0",
  "description": "CineNova - Premium Streaming Platform",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder --win",
    "build:dir": "electron-builder --win --dir"
  },
  "author": "RNA Group",
  "license": "MIT",
  "devDependencies": {
    "electron": "^36.4.0",
    "electron-builder": "^26.0.12",
    "png-to-ico": "^3.0.1"
  },
  "build": {
    "appId": "com.rna.cinenova",
    "productName": "CineNova",
    "copyright": "Copyright © 2026 RNA Group",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "icon.png",
      "!tv-app/**",
      "!dist/**",
      "!node_modules/.cache/**",
      "!.agents/**",
      "!.git/**"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "CineNova",
      "license": "LICENSE.txt",
      "installerSidebar": null,
      "artifactName": "CineNova_Setup_${version}.${ext}"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "maycalmrdem-star",
        "repo": "cinenova-releases",
        "releaseType": "release"
      }
    ]
  },
  "dependencies": {
    "@cliqz/adblocker-electron": "^1.34.0",
    "cross-fetch": "^4.1.0",
    "electron-updater": "^6.8.9"
  }
}
